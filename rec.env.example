# Copy this file to rec.env before first use:
#   cp rec.env.example rec.env
#
# Find audio sources with:
#   pactl list short sources
#
# Sourced by bin/rec, bin/rec-supervisor and bin/rec-finalize.

# --- Capture ---
DEVICE="/dev/video0"
# MJPEG is recommended for higher frame rates. Some cameras reduce their
# maximum frame rate when a raw format is selected.
INPUT_FORMAT="mjpeg"
VIDEO_SIZE="1280x720"     # set to a mode your camera supports
FRAMERATE="30"

# --- Audio ---
AUDIO_ENABLED=1
# `default` follows the system default input. Set an explicit source if needed.
AUDIO_SOURCE="default"
AUDIO_BITRATE="128k"

# Optional ALSA gain enforcement, applied before every recording.
# Leave MIC_GAIN=0 unless the control names exist on your hardware.
# MIC_CAPTURE is a raw ALSA value; the useful range and dB scale are
# hardware-specific.
MIC_GAIN=0
MIC_BOOST=0
MIC_CAPTURE=112

# --- Webcam codec ---
# Default requires NVIDIA NVENC/NVDEC. Without an NVIDIA GPU use libsvtav1 or
# libx264 (see README).
VIDEO_CODEC="${VIDEO_CODEC:-hevc_nvenc}"
CRF="${CRF:-31}"                 # SVT-AV1 / x264 quality
PRESET="${PRESET:-8}"            # SVT-AV1 preset / x264 preset name
# SVT-AV1 prediction structure: 1 = low delay, 2 = random access.
# Low delay keeps the audio tail aligned when stopping.
SVT_PRED_STRUCT="${SVT_PRED_STRUCT:-1}"
# NVENC quality and effort (used when VIDEO_CODEC is an NVENC encoder).
NVENC_CQ="${NVENC_CQ:-30}"
NVENC_PRESET="${NVENC_PRESET:-p5}"
# Decode MJPG on NVDEC and feed CUDA frames to NVENC. Set 0 for CPU decode.
GPU_DECODE="${GPU_DECODE:-1}"

# --- Recording ---
SEGMENT_SECONDS="600"            # chunk length
OUTPUT_DIR="${OUTPUT_DIR:-$HOME/Videos/webcam-recorder}"
MIN_FREE_GB="20"                 # stop below this free-space reserve
INHIBIT=1                        # hold a sleep inhibitor while recording
KEEP_PARTS=0                     # keep chunks after the MP4 is verified

# --- Screen mode ---
SCREEN_CODEC="hevc_nvenc"        # hevc_nvenc | h264_nvenc | libx264
SCREEN_CQ="28"                   # NVENC CQ, or x264 CRF
SCREEN_PRESET="p5"
SCREEN_FRAMERATE="30"
SCREEN_SIZE="auto"               # auto, or e.g. "1920x1080"
SCREEN_AUDIO="system"            # system | mic | both | none
SCREEN_AUDIO_BITRATE="192k"
# `auto` derives the default sink's monitor. Set explicitly if needed:
#   AUDIO_MONITOR="<sink>.monitor"
AUDIO_MONITOR="${AUDIO_MONITOR:-auto}"

# --- Preview ---
# In screen mode the preview window is captured as the PiP.
PREVIEW_WIDTH="320"
PREVIEW_HEIGHT="180"
PREVIEW_MARGIN="20"
PREVIEW_TITLE="Webcam Preview"
